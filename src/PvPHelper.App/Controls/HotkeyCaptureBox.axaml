<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="PvPHelper.App.Controls.HotkeyCaptureBox"
             x:Name="Root" x:CompileBindings="False">

  <Button Classes="ghost" Click="OnClick" HorizontalAlignment="Left" Padding="10,7">
    <StackPanel Orientation="Horizontal" Spacing="10">
      <Border Classes="keyChip">
        <TextBlock Text="{Binding Hotkey.Display, ElementName=Root}"/>
      </Border>
      <TextBlock Text="Click to rebind" VerticalAlignment="Center"
                 Foreground="{StaticResource TextMutedBrush}"
                 IsVisible="{Binding !IsCapturing, ElementName=Root}"/>
      <TextBlock Text="Press a key · Mouse 4/5 · Esc cancels" VerticalAlignment="Center"
                 Foreground="{StaticResource AccentBrightBrush}"
                 IsVisible="{Binding IsCapturing, ElementName=Root}"/>
    </StackPanel>
  </Button>
</UserControl>
