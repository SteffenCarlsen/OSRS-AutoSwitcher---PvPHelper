<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PvPHelper.App.ViewModels"
             x:Class="PvPHelper.App.Views.DashboardView"
             x:DataType="vm:DashboardViewModel">

  <StackPanel Spacing="16">

    <!-- Page header -->
    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="h1" Text="Dashboard" VerticalAlignment="Bottom"/>
      <TextBlock Classes="sub" Text="Command center" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
    </StackPanel>

    <!-- Arm hero -->
    <Border Classes="armHero" Classes.armed="{Binding Session.IsArmed}">
      <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
        <Button Command="{Binding Session.ToggleArmCommand}" Background="Transparent"
                Padding="0" BorderThickness="0" VerticalAlignment="Center">
          <Border Classes="bigTog" Classes.armed="{Binding Session.IsArmed}">
            <TextBlock Text="⏻" FontSize="30" HorizontalAlignment="Center" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
          </Border>
        </Button>

        <StackPanel Grid.Column="1" Margin="22,0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="eyebrow" Text="MASTER STATE"/>
          <TextBlock Text="{Binding Session.ArmLabel}" FontSize="26" FontWeight="SemiBold"/>
          <TextBlock Classes="mono" Foreground="{StaticResource TextMutedBrush}"
                     Text="{Binding Session.RunningTime}"/>
        </StackPanel>

        <StackPanel Grid.Column="2" VerticalAlignment="Center" Spacing="8">
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <TextBlock Classes="muted" Text="Arm / disarm" VerticalAlignment="Center" FontSize="11.5"/>
            <Border Classes="keyChip"><TextBlock Text="F8"/></Border>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
            <TextBlock Classes="muted" Text="Panic / stop" VerticalAlignment="Center" FontSize="11.5"/>
            <Border Classes="keyChip"><TextBlock Text="Esc"/></Border>
          </StackPanel>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Stat tiles -->
    <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="12">
      <Border Classes="tile" Grid.Column="0">
        <StackPanel Spacing="7">
          <TextBlock Classes="eyebrow" Text="PROFILE"/>
          <TextBlock Text="{Binding Session.Profile.Name}" FontSize="18" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
      <Border Classes="tile" Grid.Column="1">
        <StackPanel Spacing="7">
          <TextBlock Classes="eyebrow" Text="BINDINGS"/>
          <TextBlock Text="{Binding BindingsSummary}" FontSize="14" FontWeight="Medium"/>
        </StackPanel>
      </Border>
      <Border Classes="tile" Grid.Column="2">
        <StackPanel Spacing="7">
          <TextBlock Classes="eyebrow" Text="CALIBRATION"/>
          <TextBlock Text="{Binding CalibrationText}" FontSize="18" FontWeight="SemiBold"
                     Foreground="{StaticResource OkBrush}"/>
        </StackPanel>
      </Border>
      <Border Classes="tile" Grid.Column="3">
        <StackPanel Spacing="7">
          <TextBlock Classes="eyebrow" Text="CLIENT MODE"/>
          <TextBlock Text="{Binding ClientModeText}" FontSize="16" FontWeight="Medium"/>
        </StackPanel>
      </Border>
    </Grid>

    <!-- Bindings -->
    <TextBlock Classes="eyebrow" Text="BINDINGS" Margin="2,4,0,0"/>
    <Border Classes="card" Padding="0" ClipToBounds="True">
      <ItemsControl ItemsSource="{Binding Bindings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:BindingRowVm">
            <Border Classes="brow" BorderBrush="{StaticResource HairlineBrush}" BorderThickness="0,0,0,1">
              <Grid ColumnDefinitions="Auto,*,Auto,Auto" VerticalAlignment="Center">
                <Border Classes="rowIco">
                  <TextBlock Text="{Binding Glyph}" FontSize="15"
                             HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Grid.Column="1" Margin="13,0" VerticalAlignment="Center" Spacing="1">
                  <TextBlock Text="{Binding Name}" FontSize="13.5" FontWeight="Medium"/>
                  <TextBlock Classes="muted" Text="{Binding Detail}" FontSize="11.5"/>
                </StackPanel>
                <Border Grid.Column="2" Classes="keyChip" Margin="0,0,14,0">
                  <TextBlock Text="{Binding HotkeyText}"/>
                </Border>
                <ToggleSwitch Grid.Column="3" IsChecked="{Binding Enabled, Mode=TwoWay}" OnContent="" OffContent=""/>
              </Grid>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </Border>

    <!-- Activity -->
    <TextBlock Classes="eyebrow" Text="ACTIVITY" Margin="2,4,0,0"/>
    <Border Classes="card">
      <StackPanel Spacing="9">
        <StackPanel Orientation="Horizontal" Spacing="11">
          <TextBlock Classes="mono muted" Text="00:14:02"/>
          <TextBlock Classes="mono" Foreground="{StaticResource AccentBrightBrush}" Text="△ Armed"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="11">
          <TextBlock Classes="mono muted" Text="00:14:05"/>
          <TextBlock Classes="mono secondary" Text="⚔ Switched · Full Rune"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="11">
          <TextBlock Classes="mono muted" Text="00:14:06"/>
          <TextBlock Classes="mono" Foreground="{StaticResource AccentBrightBrush}" Text="✦ Prayer · Protect from Melee"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="11">
          <TextBlock Classes="mono muted" Text="00:14:09"/>
          <TextBlock Classes="mono secondary" Text="☄ Spec ×2 on target"/>
        </StackPanel>
      </StackPanel>
    </Border>

  </StackPanel>
</UserControl>
