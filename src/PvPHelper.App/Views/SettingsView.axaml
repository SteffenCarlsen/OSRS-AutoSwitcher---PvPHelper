<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:PvPHelper.App.ViewModels"
             x:Class="PvPHelper.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <StackPanel Spacing="16">

    <StackPanel Orientation="Horizontal" Spacing="12">
      <TextBlock Classes="h1" Text="Settings" VerticalAlignment="Bottom"/>
      <TextBlock Classes="sub" Text="Anti-ban, client &amp; input" VerticalAlignment="Bottom" Margin="0,0,0,3"/>
    </StackPanel>

    <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="16" RowSpacing="16">

      <!-- Anti-ban -->
      <Border Classes="card" Grid.Row="0" Grid.Column="0">
        <StackPanel Spacing="4">
          <TextBlock Classes="cardTitle" Text="Anti-ban / humanisation"/>
          <TextBlock Classes="cardDesc" Text="Randomised movement for more human-like input — tune the feel."/>

          <Grid ColumnDefinitions="*,Auto" Margin="0,14,0,0">
            <TextBlock Text="Mouse speed" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding Speed, StringFormat={}{0:0} steps}"/>
          </Grid>
          <Slider Minimum="1" Maximum="40" Value="{Binding Speed, Mode=TwoWay}"/>
          <TextBlock Classes="cardDesc" Text="Lower = faster."/>

          <Grid ColumnDefinitions="*,Auto" Margin="0,10,0,0">
            <TextBlock Text="Click jitter radius" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding JitterRadius, StringFormat={}±{0:0} px}"/>
          </Grid>
          <Slider Minimum="0" Maximum="15" Value="{Binding JitterRadius, Mode=TwoWay}"/>

          <Border Classes="settingRow">
            <Grid ColumnDefinitions="*,Auto">
              <TextBlock Text="Return to old position" VerticalAlignment="Center"/>
              <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding ReturnToOldPos, Mode=TwoWay}"/>
            </Grid>
          </Border>
          <Border Classes="settingRow">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel>
                <TextBlock Text="Curved paths"/>
                <TextBlock Classes="cardDesc" Text="Slight arc instead of straight lines"/>
              </StackPanel>
              <ToggleSwitch Grid.Column="1" OnContent="" OffContent="" IsChecked="{Binding CurvedPaths, Mode=TwoWay}"/>
            </Grid>
          </Border>
        </StackPanel>
      </Border>

      <!-- Client mode -->
      <Border Classes="card" Grid.Row="0" Grid.Column="1">
        <StackPanel Spacing="4">
          <TextBlock Classes="cardTitle" Text="Client mode"/>
          <TextBlock Classes="cardDesc" Text="Drives grid spacing so Fixed / Resizable / Stretched all line up."/>
          <StackPanel Orientation="Horizontal" Spacing="18" Margin="0,14,0,0">
            <RadioButton GroupName="client" Content="Fixed" IsChecked="{Binding IsFixed, Mode=TwoWay}"/>
            <RadioButton GroupName="client" Content="Resizable" IsChecked="{Binding IsResizable, Mode=TwoWay}"/>
            <RadioButton GroupName="client" Content="Stretched" IsChecked="{Binding IsStretched, Mode=TwoWay}"/>
          </StackPanel>
          <Grid ColumnDefinitions="*,Auto" Margin="0,16,0,0">
            <TextBlock Text="UI scale" VerticalAlignment="Center"/>
            <TextBlock Grid.Column="1" Classes="mono muted" Text="{Binding UiScalePercent, StringFormat={}{0:0}%}"/>
          </Grid>
          <Slider Minimum="50" Maximum="200" Value="{Binding UiScalePercent, Mode=TwoWay}"/>
        </StackPanel>
      </Border>

      <!-- Game window (input target) -->
      <Border Classes="card" Grid.Row="1" Grid.Column="0">
        <StackPanel Spacing="4">
          <TextBlock Classes="cardTitle" Text="Game window"/>
          <TextBlock Classes="cardDesc" Text="Input is posted to this window (PostMessage) — the game can stay unfocused. Defaults to RuneLite when it's running."/>

          <StackPanel Margin="0,14,0,0" Spacing="8">
            <TextBlock Text="Target window" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}"/>
            <Grid ColumnDefinitions="*,Auto">
              <ComboBox ItemsSource="{Binding Windows}"
                        SelectedItem="{Binding SelectedWindow, Mode=TwoWay}"
                        HorizontalAlignment="Stretch" MaxDropDownHeight="320"
                        PlaceholderText="Select a window…">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:GameWindowOption">
                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis"/>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <Button Grid.Column="1" Classes="ghost" Content="Refresh" Margin="8,0,0,0" Command="{Binding RefreshWindowsCommand}"/>
            </Grid>
            <TextBlock Classes="mono muted" Text="{Binding WindowStatus}" FontSize="11.5"/>

            <TextBlock Text="Match by title (fallback — used when the game isn't open yet)" FontSize="11.5"
                       Foreground="{StaticResource TextMutedBrush}" Margin="0,8,0,0"/>
            <Grid ColumnDefinitions="*,Auto">
              <TextBox PlaceholderText="RuneLite" Text="{Binding TargetWindowTitle, Mode=TwoWay}"/>
              <Button Grid.Column="1" Classes="ghost" Content="Check" Margin="8,0,0,0" Command="{Binding CheckWindowCommand}"/>
            </Grid>
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Timing (advanced) -->
      <Border Classes="card" Grid.Row="1" Grid.Column="1">
        <StackPanel Spacing="4">
          <TextBlock Classes="cardTitle" Text="Timing (advanced)"/>
          <TextBlock Classes="cardDesc" Text="Fine-tune every engine delay (ms)."/>
          <Grid ColumnDefinitions="Auto,*,Auto,*" RowDefinitions="Auto,Auto,Auto" Margin="0,12,0,0" RowSpacing="10">
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Move step" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="0" Grid.Column="1" Value="{Binding StepDelay, Mode=TwoWay}" Minimum="0" Maximum="100" Increment="1" Width="122" Margin="8,0,0,0" HorizontalAlignment="Left"/>
            <TextBlock Grid.Row="0" Grid.Column="2" Text="Pre-click" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <NumericUpDown Grid.Row="0" Grid.Column="3" Value="{Binding PreClickDelay, Mode=TwoWay}" Minimum="0" Maximum="500" Increment="5" Width="122" Margin="8,0,0,0" HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tab delay" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding TabDelay, Mode=TwoWay}" Minimum="0" Maximum="200" Increment="5" Width="122" Margin="8,0,0,0" HorizontalAlignment="Left"/>
            <TextBlock Grid.Row="1" Grid.Column="2" Text="Action gap" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <NumericUpDown Grid.Row="1" Grid.Column="3" Value="{Binding ActionGap, Mode=TwoWay}" Minimum="0" Maximum="500" Increment="5" Width="122" Margin="8,0,0,0" HorizontalAlignment="Left"/>

            <TextBlock Grid.Row="2" Grid.Column="0" Text="Switch click" VerticalAlignment="Center"/>
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding SwitchClickDelay, Mode=TwoWay}" Minimum="0" Maximum="500" Increment="5" Width="122" Margin="8,0,0,0" HorizontalAlignment="Left"/>
            <TextBlock Grid.Row="2" Grid.Column="2" Text="Spec interval" VerticalAlignment="Center" Margin="16,0,0,0"/>
            <NumericUpDown Grid.Row="2" Grid.Column="3" Value="{Binding SpecClickInterval, Mode=TwoWay}" Minimum="0" Maximum="1000" Increment="10" Width="122" Margin="8,0,0,0" HorizontalAlignment="Left"/>
          </Grid>
        </StackPanel>
      </Border>

    </Grid>
  </StackPanel>
</UserControl>
